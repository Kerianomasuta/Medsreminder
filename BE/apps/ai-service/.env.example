AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=3532

# EXE: OpenRouter vision model. The URL of the prescription photo must be public.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=qwen/qwen2.5-vl-72b-instruct:free

