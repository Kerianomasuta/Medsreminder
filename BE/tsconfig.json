{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@lib/error-handling": [
        "libs/error-handling/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/meds-backend/tsconfig.app.json"
    },
    {
      "path": "./apps/medication-service/tsconfig.app.json"
    }
  ]
}