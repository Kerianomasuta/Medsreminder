<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6090D16"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_reminder_card"
        android:padding="26dp"
        android:elevation="12dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ Đến giờ uống thuốc!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/tvReminderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_time"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="13:10"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4F46E5" />
        </LinearLayout>

        <!-- Snooze badge (Chỉ hiện khi đang nhắc lại lần thứ X) -->
        <TextView
            android:id="@+id/tvSnoozeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_dismiss"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="⏰ Nhắc lại lần 1/5"
            android:textColor="#D97706"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#F1F5F9" />

        <!-- Medicine Name -->
        <TextView
            android:id="@+id/tvMedicineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paracetamol 500mg"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <!-- Dosage & Instructions -->
        <TextView
            android:id="@+id/tvDosageInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2 VIÊN · Sau khi ăn"
            android:textSize="15sp"
            android:textColor="#64748B" />

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnSnooze"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_dismiss"
                android:text="⏰ Nhắc lại (5p)"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#D97706" />

            <Button
                android:id="@+id/btnTaken"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:background="@drawable/btn_taken"
                android:text="✓ ĐÃ UỐNG"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Nút bỏ qua / tắt hẳn -->
        <TextView
            android:id="@+id/btnDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Bỏ qua cữ này (Tắt hẳn)"
            android:textSize="13sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

</FrameLayout>
